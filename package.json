{
  "name": "testmoon",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "format": "prettier --write \"{frontend,libs/frontend}/**/*.{html,ts,tsx,css,json}\"",
    "format:check": "prettier --check \"{frontend,libs/frontend}/**/*.{html,ts,tsx,css,json}\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "3.9.10",
    "typescript": "catalog:"
  }
}
